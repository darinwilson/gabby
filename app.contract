use OAuthResult from "@exact/oauth"

atom hashtag link="tag:" role="link" padding-inline="10px" border-radius="999px" color="light-dark(#4338ca, #c7d2fe)" background-color="light-dark(#eef2ff, #2e2a5c)"
  :hover
    background-color="light-dark(#e0e7ff, #3a3570)"

shape Connection
  ok: bool
  error: string
  host: string

shape Post
  id: string
  statusId: string
  name: string
  handle: string
  avatar: string
  text: string
  boostedBy: string
  boostedAvatar: string
  posted: number
  visibility: string
  replies: number
  reblogs: number
  favourites: number
  reblogged: bool
  favourited: bool
  accountId: string
  pinned: bool

shape Timeline
  host: string
  home: bool
  tag: string
  posts: Post[]
  hasNext: bool
  signedIn: bool

shape Reply
  ok: bool

shape Thread
  host: string
  id: string
  ancestors: Post[]
  post: Post
  replies: Post[]
  signedIn: bool

shape Field
  key: string
  name: string
  value: string

// An account's profile and its posts: pinned ones first, then the rest newest first.
shape Person
  host: string
  id: string
  name: string
  handle: string
  avatar: string
  banner: string
  bio: string
  fields: Field[]
  followers: number
  following: number
  statuses: number
  pinned: Post[]
  posts: Post[]
  hasNext: bool
  signedIn: bool
  self: bool
  followed: bool
  requested: bool

shape Account
  host: string
  supported: bool
  signedIn: bool
  error: string

shape Profile
  host: string
  name: string
  handle: string
  avatar: string

shape Attachment
  id: string
  kind: string
  preview: string
  name: string

shape Outcome
  ok: bool
  error: string

shape Server
  host: string

shape Viewport
  width: number

shape Instance
  domain: string
  title: string
  description: string
  thumbnail: string

routes nav
  home "/"
    timeline "/timeline/:host"
    feed "/feed/:host"
    tag "/tag/:host/:tag"
    post "/post/:host/:id"
    account "/account/:host/:id"
    compose "/compose/:host"

component Gabby
  state draft = "" persist
  mutation connected as shape Connection then afterConnect
  derive connectError = match connected { case some(c) => c.error, case none => "" }
  derive showError = connectError != "" and not pending(connected)
  derive connectedHost = match connected { case some(c) => (c.ok ? c.host : ""), case none => "" }
  state server = ""
  resource account = loadAccount(server) when server != "" as shape Account else empty()
  derive accountReady = account.host == server
  resource recent = loadRecent() as shape Server[] else empty()
  mutation signedIn as shape OAuthResult refreshes account, recent then afterSignIn
  derive signInOk = match signedIn { case some(r) => r.ok, case none => false }
  derive signInError = match signedIn { case some(r) => (r.ok or r.code == "cancelled" ? "" : r.error), case none => "" }
  derive accountError = accountReady ? (account.error != "" ? account.error : signInError) : ""
  derive optionsHint = accountError != "" ? accountError : (accountReady and not account.supported ? `You can't log in to ${server} from Gabby. Login works with fosstodon.org, mastodon.social and mastodon.art.` : "")
  // The timeline nearest the top, which stays loaded and scrolled under a post opened from it.
  derive timelines = stack(nav).filter(e => e.name == "timeline" or e.name == "feed" or e.name == "tag")
  derive shown = match timelines.at(-1) { case some(e) => e, case none => top(nav) }
  derive home = shown.name == "feed"
  derive inFeed = stack(nav).map(e => e.name == "feed").includes(true)
  derive tag = shown.name == "tag" ? shown.params.tag : ""
  derive host = shown.name == "timeline" or home or tag != "" ? shown.params.host : ""
  resource timeline = loadTimeline(host, home, tag) when host != "" as shape Timeline else empty() transient
  mutation more as shape Reply refreshes timeline
  mutation acted as shape Reply refreshes timeline
  derive loading = pending(timeline) or pending(more)
  derive posts = timeline.host == host and timeline.home == home and timeline.tag == tag ? timeline.posts : []
  resource viewport = exactViewport() as shape Viewport
  derive wide = viewport.width >= 768
  derive centered = wide and viewport.width >= 1264
  resource instance = loadInstance(host) when host != "" and wide as shape Instance else empty()
  resource profile = loadProfile(host) when home and wide as shape Profile else empty()
  derive rows = pending(more) ? posts.concat([Post(id="loading", statusId="", name="", handle="", avatar="", text="", boostedBy="", boostedAvatar="", posted=0, visibility="", replies=0, reblogs=0, favourites=0, reblogged=false, favourited=false, accountId="", pinned=false)]) : posts
  derive timelineError = match failure(timeline) { case some(f) => (f.code == "auth-required" ? "This server only shows its public timeline to signed-in users." : "Couldn't load the timeline."), case none => "" }

  action edit(v: string)
    draft = v
    server = ""
  action connect
    if draft.trim() != "" and not pending(connected)
      send connected = connect(draft.trim())
  action afterConnect
    if connectedHost != ""
      server = connectedHost
  action signIn
    if accountReady and account.supported and not pending(signedIn)
      send signedIn = signIn(server)
  action afterSignIn
    if signInOk
      nav = go(nav, path("feed", server))
  action showFeed
    nav = go(nav, path("feed", server))
  action switchInstance
    nav = back(nav)
  action showPublic
    nav = push(nav, path("timeline", server))
  action loadMore
    if timeline.hasNext and not loading
      send more = nextPage(host, home, tag)
  action retry
    refresh timeline
  action back
    nav = back(nav)
  action follow(url: string)
    nav = go(nav, url)
  action openTag(e: AtomEvent)
    nav = go(nav, e.href.slice(4))
  action openPost(p: Post)
    if p.statusId != ""
      nav = push(nav, path("post", host, p.statusId))
  action showPost(h: string, id: string)
    nav = push(nav, path("post", h, id))
  action openAccount(p: Post)
    if p.accountId != ""
      nav = push(nav, path("account", host, p.accountId))
  action showAccount(h: string, id: string)
    nav = push(nav, path("account", h, id))
  action postChanged
    refresh timeline
  action compose
    nav = push(nav, path("compose", host))
  action composed
    nav = back(nav)
    refresh timeline
  action favourite(p: Post)
    if timeline.signedIn and not pending(acted)
      send acted = act(host, p.statusId, p.favourited ? "unfavourite" : "favourite")
  action boost(p: Post)
    if timeline.signedIn and not pending(acted)
      send acted = act(host, p.statusId, p.reblogged ? "unreblog" : "reblog")

  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="server-form" navigationSplit=(inFeed ? "none" : "320") position="absolute" inset=0 display="flex" flex-direction="column"
            header
              text "Gabby" role="heading" aria-level=1
            list id="server-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                row gap=8 align-items="center"
                  input value=draft input=edit submit=connect placeholder="mastodon.social" aria-label="Mastodon server"
                    inputmode="url" autocapitalize="none" autocomplete="off" enterkeyhint="go" flex=1 min-width=0 testId="server"
                  if pending(connected)
                    progress aria-label="Connecting" testId="connecting"
                  else
                    button press=connect disabled=(draft.trim() == "") buttonStyle="filled" testId="connect"
                      text "Connect"
                footer
                  text (showError ? connectError : "Enter the address of a Mastodon server.")
                    color=(showError ? "-exact-system-red" : "-exact-secondary-label") testId="server-hint"
              if server != ""
                section testId="options"
                  if accountReady and account.supported
                    row
                      if pending(signedIn)
                        progress aria-label="Logging in" testId="logging-in"
                      else if account.signedIn
                        button press=showFeed testId="show-feed"
                          text "Show Home Timeline"
                      else
                        button press=signIn testId="log-in"
                          text "Log In"
                  row
                    button press=showPublic testId="show-public"
                      text "Show Public Timeline"
                  footer
                    text optionsHint color=(accountError != "" ? "-exact-system-red" : "-exact-secondary-label") testId="options-hint"
              if recent.length > 0
                section testId="recent"
                  header
                    text "Recent"
                  for r in recent key=r.host
                    link href=path("feed", r.host) testId=`recent-${r.host}`
                      text r.host
                      image "symbol:forward-chevron"
        if e.name == "timeline" or e.name == "feed" or e.name == "tag"
          column navigationKey=`${e.id}` navigationScroll="posts" position="absolute" inset=0 display="flex" flex-direction="column"
            header
              if e.name == "tag"
                button id="back" press=back testId="back"
                  text "Back"
              text (e.name == "feed" ? "Home" : e.name == "tag" ? `#${e.params.tag}` : "Public") role="heading" aria-level=2 testId="timeline-title"
            row flex=1 min-height=0
              if wide and instance.domain == host
                aside width=(centered ? "calc(50% - 300px)" : "18.75rem") flex-shrink=0 overflow-y="auto" box-sizing="border-box" padding=16 testId="instance"
                  column width="100%" max-width="18.75rem" margin-left="auto" margin-right="auto" gap=12 display="flex" flex-direction="column"
                    if home and profile.host == host
                      row gap=12 align-items="center" testId="profile"
                        image profile.avatar width=44 height=44 border-radius=22 object-fit="cover" alt=""
                        column flex=1 min-width=0 gap=2
                          text profile.name overflow-wrap="break-word" font-weight=600 testId="profile-name"
                          text profile.handle overflow-wrap="break-word" font="-exact-footnote" color="-exact-secondary-label" testId="profile-handle"
                    if timeline.signedIn and timeline.host == host
                      Composer(host=host, prefix="side-", done=postChanged)
                    if instance.thumbnail != ""
                      image instance.thumbnail width="100%" aspect-ratio="1.91" object-fit="cover" border-radius=12 alt=""
                    text instance.title font="-exact-title2" font-weight=700 overflow-wrap="break-word" testId="instance-title"
                    link href=`https://${instance.domain}` testId="instance-url"
                      text `https://${instance.domain}` overflow-wrap="break-word"
                    text instance.description white-space="pre-line" color="-exact-secondary-label" overflow-wrap="break-word" testId="instance-description"
                    if home
                      button press=switchInstance buttonStyle="bordered" testId="switch-instance"
                        text "Switch Instance"
              column flex=1 min-width=0 display="flex" flex-direction="column"
                if timelineError != "" and posts.length == 0
                  column padding=16 gap=12 align-items="center"
                    text timelineError text-align="center" testId="timeline-error"
                    button press=retry buttonStyle="bordered" testId="retry"
                      text "Try Again"
                else if posts.length == 0 and pending(timeline)
                  column padding=16 align-items="center"
                    progress aria-label="Loading" testId="loading"
                else
                  list id="posts" testId="posts" virtualized=true appearance="none" flex=1 min-height=0
                    estimated-item-height=120 reachend=loadMore reach-margin="100%"
                    for p in rows key=p.id
                      PostRow(p=p, wide=wide, signedIn=timeline.signedIn, prefix="", open=openPost, profile=openAccount, boost=boost, favourite=favourite, openTag=openTag, focused=false)
            if not wide and timeline.signedIn and timeline.host == host
              button press=compose aria-label="New post" appearance="none" background-color="-exact-label" color="-exact-background" position="absolute" right=16 bottom=24
                width=56 height=56 border-radius=28 padding=0 box-shadow="0 2px 8px rgba(0, 0, 0, 0.3)" testId="compose-fab"
                image "symbol:compose" font-size="-exact-title3"

              if centered and instance.domain == host
                column width="calc(50% - 300px)" flex-shrink=0
        if e.name == "post"
          PostView(route=`${e.id}`, host=e.params.host, id=e.params.id, wide=wide, back=back, show=showPost, person=showAccount, openTag=openTag, changed=postChanged)
        if e.name == "compose"
          column navigationKey=`${e.id}` navigationScroll="compose" position="absolute" inset=0 display="flex" flex-direction="column"
            header
              button id="back" press=back testId="compose-back"
                text "Cancel"
              text "New Post" role="heading" aria-level=2 testId="compose-title"
            column flex=1 min-height=0 overflow-y="auto" padding=16 width="100%" max-width="37.5rem" margin-left="auto" margin-right="auto" box-sizing="border-box"
              Composer(host=e.params.host, prefix="", done=composed)
        if e.name == "account"
          PersonView(route=`${e.id}`, host=e.params.host, id=e.params.id, wide=wide, back=back, show=showPost, person=showAccount, openTag=openTag, changed=postChanged)

// A post and the posts around it: what it replies to above, its replies below.
component PostView
  props
    route: string
    host: string
    id: string
    wide: bool
    back: action
    show: action
    person: action
    openTag: action
    changed: action
  resource thread = loadThread(host, id) as shape Thread else empty() transient
  mutation acted as shape Reply refreshes thread then afterAct
  derive ready = thread.host == host and thread.id == id
  derive error = match failure(thread) { case some(f) => (f.code == "not-found" ? "This post isn't available." : f.code == "auth-required" ? "This server only shows posts to signed-in users." : f.code == "auth-expired" ? "Log in again to see this post." : "Couldn't load the post."), case none => "" }

  action open(p: Post)
    if p.statusId != id
      show(host, p.statusId)
  action openPerson(p: Post)
    if p.accountId != ""
      person(host, p.accountId)
  action afterAct
    changed()
  action favourite(p: Post)
    if thread.signedIn and not pending(acted)
      send acted = act(host, p.statusId, p.favourited ? "unfavourite" : "favourite")
  action boost(p: Post)
    if thread.signedIn and not pending(acted)
      send acted = act(host, p.statusId, p.reblogged ? "unreblog" : "reblog")
  action retry
    refresh thread

  view
    column navigationKey=route navigationScroll="thread" position="absolute" inset=0 display="flex" flex-direction="column"
      header
        button id="back" press=back testId="post-back"
          text "Back"
        text "Post" role="heading" aria-level=2 testId="post-title"
      if error != "" and not ready
        column padding=16 gap=12 align-items="center"
          text error text-align="center" testId="thread-error"
          button press=retry buttonStyle="bordered" testId="thread-retry"
            text "Try Again"
      else if not ready
        column padding=16 align-items="center"
          progress aria-label="Loading" testId="thread-loading"
      else
        list id="thread" testId="thread" appearance="none" flex=1 min-height=0
          for p in thread.ancestors key=p.id
            PostRow(p=p, wide=wide, signedIn=thread.signedIn, prefix="thread-", open=open, profile=openPerson, boost=boost, favourite=favourite, openTag=openTag, focused=false)
          PostRow(p=thread.post, wide=wide, signedIn=thread.signedIn, prefix="focus-", focused=true, open=open, profile=openPerson, boost=boost, favourite=favourite, openTag=openTag)
          for p in thread.replies key=p.id
            PostRow(p=p, wide=wide, signedIn=thread.signedIn, prefix="thread-", open=open, profile=openPerson, boost=boost, favourite=favourite, openTag=openTag, focused=false)

// An account's profile above its posts.
component PersonView
  props
    route: string
    host: string
    id: string
    wide: bool
    back: action
    show: action
    person: action
    openTag: action
    changed: action
  resource who = loadPerson(host, id) as shape Person else empty() transient
  mutation acted as shape Reply refreshes who then afterAct
  mutation more as shape Reply refreshes who
  mutation followed as shape Reply refreshes who
  derive ready = who.host == host and who.id == id
  derive error = match failure(who) { case some(f) => (f.code == "not-found" ? "This account isn't available." : f.code == "auth-required" ? "This server only shows profiles to signed-in users." : f.code == "auth-expired" ? "Log in again to see this profile." : "Couldn't load the profile."), case none => "" }
  derive followLabel = who.followed ? "Unfollow" : who.requested ? "Requested" : "Follow"

  action open(p: Post)
    show(host, p.statusId)
  action openPerson(p: Post)
    if p.accountId != id
      person(host, p.accountId)
  action afterAct
    changed()
  action favourite(p: Post)
    if who.signedIn and not pending(acted)
      send acted = act(host, p.statusId, p.favourited ? "unfavourite" : "favourite")
  action boost(p: Post)
    if who.signedIn and not pending(acted)
      send acted = act(host, p.statusId, p.reblogged ? "unreblog" : "reblog")
  action toggleFollow
    if who.signedIn and not pending(followed)
      send followed = setFollow(host, id, not (who.followed or who.requested))
  action loadMore
    if ready and who.hasNext and not pending(more)
      send more = morePosts(host, id)
  action retry
    refresh who

  view
    column navigationKey=route navigationScroll="person" position="absolute" inset=0 display="flex" flex-direction="column"
      header
        button id="back" press=back testId="person-back"
          text "Back"
        text (ready ? who.name : "Profile") role="heading" aria-level=2 testId="person-title"
      if error != "" and not ready
        column padding=16 gap=12 align-items="center"
          text error text-align="center" testId="person-error"
          button press=retry buttonStyle="bordered" testId="person-retry"
            text "Try Again"
      else if not ready
        column padding=16 align-items="center"
          progress aria-label="Loading" testId="person-loading"
      else
        list id="person" testId="person" appearance="none" flex=1 min-height=0
          column width="100%" box-sizing="border-box" max-width=(wide ? "600px" : "none") margin-left="auto" margin-right="auto" padding-bottom=16
            border-style="solid" border-color="-exact-separator" border-width=(wide ? "0 1px 1px" : "0 0 1px") testId="person-about"
            if who.banner != ""
              image who.banner width="100%" aspect-ratio="3" object-fit="cover" alt="" testId="person-banner"
            else
              column width="100%" aspect-ratio="3" background-color="-exact-fill"
            column padding-left=16 padding-right=16 gap=10
              row align-items="flex-end" justify-content="space-between" gap=12 margin-top=-36
                if who.avatar != ""
                  image who.avatar width=80 height=80 border-radius="50%" border-width=3 border-style="solid" border-color="-exact-background" object-fit="cover" alt="" testId="person-avatar"
                else
                  column width=80 height=80 border-radius="50%" border-width=3 border-style="solid" border-color="-exact-background" background-color="-exact-fill" testId="person-avatar"
                if who.signedIn and not who.self
                  button press=toggleFollow disabled=pending(followed) buttonStyle=(who.followed or who.requested ? "bordered" : "filled") testId="person-follow"
                    text followLabel
              column gap=2
                text who.name font="-exact-title2" font-weight=700 overflow-wrap="break-word" testId="person-name"
                text who.handle font="-exact-subheadline" color="-exact-secondary-label" overflow-wrap="break-word" testId="person-handle"
              if who.bio != ""
                text who.bio markup="markdown" atoms="hashtag" atompress=openTag overflow-wrap="break-word" testId="person-bio"
              if who.fields.length > 0
                column gap=6 testId="person-fields"
                  for f in who.fields key=f.key
                    row gap=8 flex-wrap="wrap" align-items="baseline"
                      text f.name font="-exact-subheadline" font-weight=600 testId=`field-name-${f.key}`
                      text f.value markup="markdown" overflow-wrap="break-word" min-width=0 testId=`field-value-${f.key}`
              row gap=16 flex-wrap="wrap" font="-exact-subheadline" testId="person-counts"
                text `${who.statuses} ${who.statuses == 1 ? "post" : "posts"}` testId="person-statuses"
                text `${who.following} following` testId="person-following"
                text `${who.followers} ${who.followers == 1 ? "follower" : "followers"}` testId="person-followers"
          for p in who.pinned key=`pinned-${p.id}`
            PostRow(p=p, wide=wide, signedIn=who.signedIn, prefix="pinned-", open=open, profile=openPerson, boost=boost, favourite=favourite, openTag=openTag, focused=false)
          if who.pinned.length == 0 and who.posts.length == 0
            text "No posts yet." padding=16 text-align="center" color="-exact-secondary-label" testId="person-empty"
          for p in who.posts key=p.id
            PostRow(p=p, wide=wide, signedIn=who.signedIn, prefix="person-", open=open, profile=openPerson, boost=boost, favourite=favourite, openTag=openTag, focused=false)
          if pending(more)
            column padding=16 align-items="center"
              progress aria-label="Loading" testId="person-more"
          if who.hasNext
            column intersect=loadMore intersect-margin="0px 0px 800px 0px" height=1

// A new post: its text, who sees it, and up to four files.
component Composer
  props
    host: string
    prefix: string
    done: action
  state text = ""
  state visibility = "public"
  resource attached = draftMedia(host) as shape Attachment[] else empty() transient
  mutation uploaded as shape Outcome refreshes attached
  mutation removed as shape Outcome refreshes attached
  mutation posted as shape Outcome refreshes attached then afterPost
  derive left = 500 - text.length
  derive busy = pending(uploaded) or pending(posted)
  derive canPost = (text.trim() != "" or attached.length > 0) and left >= 0 and not busy
  derive uploadError = match uploaded { case some(o) => o.error, case none => "" }
  derive postError = match posted { case some(o) => o.error, case none => "" }
  derive postOk = match posted { case some(o) => o.ok, case none => false }

  action edit(v: string)
    text = v
  action setVisibility(v: string)
    visibility = v
  action attach
    showPicker(`${prefix}compose-file`)
  action picked(files: Picked[])
    if files.length > 0 and not busy
      send uploaded = uploadMedia(host, files)
  action remove(a: Attachment)
    send removed = dropMedia(host, a.id)
  action submit
    if canPost
      send posted = publish(host, text, visibility)
  action afterPost
    if postOk
      text = ""
      visibility = "public"
      done()

  view
    column gap=10 testId=`${prefix}compose`
      textarea value=text input=edit placeholder="What's on your mind?" aria-label="Post text" min-height=120 width="100%" box-sizing="border-box" testId=`${prefix}compose-text`
      if attached.length > 0
        row gap=8 flex-wrap="wrap" testId=`${prefix}compose-media`
          for a in attached key=a.id
            column position="relative" width=72 height=72 border-radius=8 overflow="hidden" background-color="-exact-fill" align-items="center" justify-content="center" testId=`${prefix}compose-media-${a.id}`
              if a.preview != ""
                image a.preview width=72 height=72 object-fit="cover" alt=a.name
              else
                image (a.kind == "audio" ? "symbol:waveform" : a.kind == "video" ? "symbol:play" : "symbol:document") aria-label=a.name
              button press=remove(a) aria-label=`Remove ${a.name}` appearance="none" position="absolute" top=2 right=2 width=24 height=24 border-radius=12 padding=0
                background-color="-exact-secondary-background" color="-exact-label" testId=`${prefix}compose-remove-${a.id}`
                image "symbol:close"
      if uploadError != ""
        text uploadError color="-exact-system-red" testId=`${prefix}compose-upload-error`
      if postError != ""
        text postError color="-exact-system-red" testId=`${prefix}compose-error`
      row gap=8 align-items="center" flex-wrap="wrap"
        input type="file" id=`${prefix}compose-file` multiple=true change=picked display="none" aria-hidden=true testId=`${prefix}compose-file`
        button press=attach disabled=(attached.length >= 4 or busy) aria-label="Add photos, video or audio" buttonStyle="bordered" testId=`${prefix}compose-attach`
          image "symbol:photo"
        select value=visibility change=setVisibility aria-label="Who can see this" testId=`${prefix}compose-visibility`
          option "Public" value="public"
          option "Quiet public" value="unlisted"
          option "Followers only" value="private"
          option "Mentioned people only" value="direct"
        if busy
          progress aria-label=(pending(uploaded) ? "Uploading" : "Posting") testId=`${prefix}compose-busy`
        text `${left}` margin-left="auto" font-variant-numeric="tabular-nums" color=(left < 0 ? "-exact-system-red" : "-exact-secondary-label") aria-label=`${left} ${left == 1 ? "character" : "characters"} left` testId=`${prefix}compose-left`
        button press=submit disabled=(not canPost) buttonStyle="filled" testId=`${prefix}compose-post`
          text "Post"

// One post in a list. Tapping it opens the post; its buttons and hashtags do their own thing.
component PostRow
  // A hashtag's press also reaches the row's; the row skips the press that opened a hashtag.
  state tagged = false
  action down
    tagged = false
  action tag(e: AtomEvent)
    tagged = true
    openTag(e)
  action pressed
    if not tagged
      open(p)
    tagged = false
  props
    p: Post
    wide: bool
    signedIn: bool
    prefix: string
    focused: bool
    open: action
    profile: action
    boost: action
    favourite: action
    openTag: action
  view
    row gap=12 padding=(wide ? 16 : 12) align-items="flex-start" width="100%" box-sizing="border-box" max-width=(wide ? "600px" : "none") margin-left="auto" margin-right="auto"
      border-style="solid" border-color="-exact-separator" border-width=(wide ? "0 1px 1px" : "0 0 1px") testId=`${prefix}post-${p.id}`
      if p.id == "loading"
        progress aria-label="Loading" testId="loading"
      else
        button appearance="none" press=profile(p) aria-label=`${p.name}'s profile` padding=0 flex-shrink=0 border-radius=22 testId=`${prefix}avatar-${p.id}`
          if p.avatar != ""
            image p.avatar width=44 height=44 border-radius=22 object-fit="cover" alt=""
          else
            column width=44 height=44 border-radius=22 background-color="-exact-fill"
        column flex=1 min-width=0
          // The press is on the content only, so the action buttons aren't nested in it.
          column press=pressed pointerdown=down gap=2 testId=`${prefix}open-${p.id}`
            if p.pinned
              row gap=6 align-items="center" font="-exact-footnote" color="-exact-secondary-label" margin-bottom=2 testId=`${prefix}pinned-${p.id}`
                image "symbol:pin" aria-hidden=true
                text "Pinned"
            if p.boostedBy != ""
              row gap=6 align-items="center" font="-exact-footnote" color="-exact-secondary-label" margin-bottom=2
                image "symbol:repeat" aria-hidden=true
                if p.boostedAvatar != ""
                  image p.boostedAvatar width=16 height=16 border-radius=8 object-fit="cover" alt=""
                text `${p.boostedBy} boosted` testId=`${prefix}boosted-${p.id}`
            row gap=6 align-items="center" flex-wrap="wrap"
              text p.name flex=1 min-width=0 overflow-wrap="break-word" font-weight=600 testId=`${prefix}name-${p.id}`
              image (p.visibility == "public" ? "symbol:icon.globe" : p.visibility == "unlisted" ? "symbol:moon" : p.visibility == "private" ? "symbol:lock" : "symbol:at")
                aria-label=(p.visibility == "public" ? "Public" : p.visibility == "unlisted" ? "Quiet public" : p.visibility == "private" ? "Followers only" : "Mentioned people only")
                font="-exact-footnote" width="1em" height="1em" flex-shrink=0 color="-exact-secondary-label" testId=`${prefix}visibility-${p.id}`
              if not focused
                text "·" font="-exact-footnote" color="-exact-secondary-label" aria-hidden=true
                time datetime=p.posted format="relative" max-width="100%" font="-exact-footnote" color="-exact-secondary-label" testId=`${prefix}time-${p.id}`
            text p.handle overflow-wrap="break-word" font="-exact-footnote" color="-exact-secondary-label"
            text p.text markup="markdown" atoms="hashtag" atompress=tag overflow-wrap="break-word" margin-top=4 font=(focused ? "-exact-title3" : "-exact-body") testId=`${prefix}text-${p.id}`
            if focused
              row gap=6 flex-wrap="wrap" margin-top=8 font="-exact-footnote" color="-exact-secondary-label" testId=`${prefix}posted-${p.id}`
                time datetime=p.posted format="date-medium"
                time datetime=p.posted format="time-short"
          row column-gap=16 flex-wrap="wrap" margin-top=4 align-items="center" font="-exact-subheadline" color="-exact-secondary-label"
            button appearance="none" disabled=true aria-label=`Reply, ${p.replies}` display="flex" gap=4 align-items="center" flex-shrink=0 min-width=44 min-height=44 testId=`${prefix}reply-${p.id}`
              image "symbol:reply" aria-hidden=true
              text (p.replies > 0 ? `${p.replies}` : "") testId=`${prefix}replies-${p.id}`
            button appearance="none" press=boost(p) disabled=(not signedIn) aria-label=(p.reblogged ? "Undo boost" : "Boost") aria-pressed=p.reblogged
              display="flex" gap=4 align-items="center" flex-shrink=0 min-width=44 min-height=44 color=(p.reblogged ? "light-dark(#1a7f37, #30d158)" : "-exact-secondary-label") testId=`${prefix}boost-${p.id}`
              image "symbol:repeat" aria-hidden=true
              text (p.reblogs > 0 ? `${p.reblogs}` : "") testId=`${prefix}reblogs-${p.id}`
            button appearance="none" press=favourite(p) disabled=(not signedIn) aria-label=(p.favourited ? "Unlike" : "Like") aria-pressed=p.favourited
              display="flex" gap=4 align-items="center" flex-shrink=0 min-width=44 min-height=44 color=(p.favourited ? "light-dark(#b45309, #ff9f0a)" : "-exact-secondary-label") testId=`${prefix}favourite-${p.id}`
              image (p.favourited ? "symbol:star-fill" : "symbol:star") aria-hidden=true
              text (p.favourites > 0 ? `${p.favourites}` : "") testId=`${prefix}favourites-${p.id}`
