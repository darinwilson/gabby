use OAuthResult from "@exact/oauth"

atom hashtag link="tag:" role="link" padding-inline="10px" border-radius="999px" color="light-dark(#4338ca, #c7d2fe)" background-color="light-dark(#eef2ff, #2e2a5c)"
  :hover
    background-color="light-dark(#e0e7ff, #3a3570)"

shape Connection
  ok: bool
  error: string
  host: string

shape Post
  id: string
  statusId: string
  name: string
  handle: string
  avatar: string
  text: string
  boostedBy: string
  boostedAvatar: string
  posted: number
  visibility: string
  replies: number
  reblogs: number
  favourites: number
  reblogged: bool
  favourited: bool

shape Timeline
  host: string
  home: bool
  tag: string
  posts: Post[]
  hasNext: bool
  signedIn: bool

shape Reply
  ok: bool

shape Thread
  host: string
  id: string
  ancestors: Post[]
  post: Post
  replies: Post[]
  signedIn: bool

shape Account
  host: string
  supported: bool
  signedIn: bool
  error: string

shape Profile
  host: string
  name: string
  handle: string
  avatar: string

shape Server
  host: string

shape Viewport
  width: number

shape Instance
  domain: string
  title: string
  description: string
  thumbnail: string

routes nav
  home "/"
    timeline "/timeline/:host"
    feed "/feed/:host"
    tag "/tag/:host/:tag"
    post "/post/:host/:id"

component Gabby
  state draft = "" persist
  mutation connected as shape Connection then afterConnect
  derive connectError = match connected { case some(c) => c.error, case none => "" }
  derive showError = connectError != "" and not pending(connected)
  derive connectedHost = match connected { case some(c) => (c.ok ? c.host : ""), case none => "" }
  state server = ""
  resource account = loadAccount(server) when server != "" as shape Account else empty()
  derive accountReady = account.host == server
  resource recent = loadRecent() as shape Server[] else empty()
  mutation signedIn as shape OAuthResult refreshes account, recent then afterSignIn
  derive signInOk = match signedIn { case some(r) => r.ok, case none => false }
  derive signInError = match signedIn { case some(r) => (r.ok or r.code == "cancelled" ? "" : r.error), case none => "" }
  derive accountError = accountReady ? (account.error != "" ? account.error : signInError) : ""
  derive optionsHint = accountError != "" ? accountError : (accountReady and not account.supported ? `You can't log in to ${server} from Gabby. Login works with fosstodon.org, mastodon.social and mastodon.art.` : "")
  // The timeline nearest the top, which stays loaded and scrolled under a post opened from it.
  derive timelines = stack(nav).filter(e => e.name == "timeline" or e.name == "feed" or e.name == "tag")
  derive shown = match timelines.at(-1) { case some(e) => e, case none => top(nav) }
  derive home = shown.name == "feed"
  derive inFeed = stack(nav).map(e => e.name == "feed").includes(true)
  derive tag = shown.name == "tag" ? shown.params.tag : ""
  derive host = shown.name == "timeline" or home or tag != "" ? shown.params.host : ""
  resource timeline = loadTimeline(host, home, tag) when host != "" as shape Timeline else empty() transient
  mutation more as shape Reply refreshes timeline
  mutation acted as shape Reply refreshes timeline
  derive loading = pending(timeline) or pending(more)
  derive posts = timeline.host == host and timeline.home == home and timeline.tag == tag ? timeline.posts : []
  resource viewport = exactViewport() as shape Viewport
  derive wide = viewport.width >= 768
  derive centered = wide and viewport.width >= 1264
  resource instance = loadInstance(host) when host != "" and wide as shape Instance else empty()
  resource profile = loadProfile(host) when home and wide as shape Profile else empty()
  derive rows = pending(more) ? posts.concat([Post(id="loading", statusId="", name="", handle="", avatar="", text="", boostedBy="", boostedAvatar="", posted=0, visibility="", replies=0, reblogs=0, favourites=0, reblogged=false, favourited=false)]) : posts
  derive timelineError = match failure(timeline) { case some(f) => (f.code == "auth-required" ? "This server only shows its public timeline to signed-in users." : "Couldn't load the timeline."), case none => "" }

  action edit(v: string)
    draft = v
    server = ""
  action connect
    if draft.trim() != "" and not pending(connected)
      send connected = connect(draft.trim())
  action afterConnect
    if connectedHost != ""
      server = connectedHost
  action signIn
    if accountReady and account.supported and not pending(signedIn)
      send signedIn = signIn(server)
  action afterSignIn
    if signInOk
      nav = go(nav, path("feed", server))
  action showFeed
    nav = go(nav, path("feed", server))
  action switchInstance
    nav = back(nav)
  action showPublic
    nav = push(nav, path("timeline", server))
  action loadMore
    if timeline.hasNext and not loading
      send more = nextPage(host, home, tag)
  action retry
    refresh timeline
  action back
    nav = back(nav)
  action follow(url: string)
    nav = go(nav, url)
  action openTag(e: AtomEvent)
    nav = go(nav, e.href.slice(4))
  action openPost(p: Post)
    if p.statusId != ""
      nav = push(nav, path("post", host, p.statusId))
  action showPost(h: string, id: string)
    nav = push(nav, path("post", h, id))
  action postChanged
    refresh timeline
  action favourite(p: Post)
    if timeline.signedIn and not pending(acted)
      send acted = act(host, p.statusId, p.favourited ? "unfavourite" : "favourite")
  action boost(p: Post)
    if timeline.signedIn and not pending(acted)
      send acted = act(host, p.statusId, p.reblogged ? "unreblog" : "reblog")

  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="server-form" navigationSplit=(inFeed ? "none" : "320") position="absolute" inset=0 display="flex" flex-direction="column"
            header
              text "Gabby" role="heading" aria-level=1
            list id="server-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                row gap=8 align-items="center"
                  input value=draft input=edit submit=connect placeholder="mastodon.social" aria-label="Mastodon server"
                    inputmode="url" autocapitalize="none" autocomplete="off" enterkeyhint="go" flex=1 min-width=0 testId="server"
                  if pending(connected)
                    progress aria-label="Connecting" testId="connecting"
                  else
                    button press=connect disabled=(draft.trim() == "") buttonStyle="filled" testId="connect"
                      text "Connect"
                footer
                  text (showError ? connectError : "Enter the address of a Mastodon server.")
                    color=(showError ? "-exact-system-red" : "-exact-secondary-label") testId="server-hint"
              if server != ""
                section testId="options"
                  if accountReady and account.supported
                    row
                      if pending(signedIn)
                        progress aria-label="Logging in" testId="logging-in"
                      else if account.signedIn
                        button press=showFeed testId="show-feed"
                          text "Show Home Timeline"
                      else
                        button press=signIn testId="log-in"
                          text "Log In"
                  row
                    button press=showPublic testId="show-public"
                      text "Show Public Timeline"
                  footer
                    text optionsHint color=(accountError != "" ? "-exact-system-red" : "-exact-secondary-label") testId="options-hint"
              if recent.length > 0
                section testId="recent"
                  header
                    text "Recent"
                  for r in recent key=r.host
                    link href=path("feed", r.host) testId=`recent-${r.host}`
                      text r.host
                      image "symbol:forward-chevron"
        if e.name == "timeline" or e.name == "feed" or e.name == "tag"
          column navigationKey=`${e.id}` navigationScroll="posts" position="absolute" inset=0 display="flex" flex-direction="column"
            header
              if e.name == "tag"
                button id="back" press=back testId="back"
                  text "Back"
              text (e.name == "feed" ? "Home" : e.name == "tag" ? `#${e.params.tag}` : "Public") role="heading" aria-level=2 testId="timeline-title"
            row flex=1 min-height=0
              if wide and instance.domain == host
                aside width=(centered ? "calc(50% - 300px)" : "18.75rem") flex-shrink=0 overflow-y="auto" box-sizing="border-box" padding=16 testId="instance"
                  column width="100%" max-width="18.75rem" margin-left="auto" margin-right="auto" gap=12 display="flex" flex-direction="column"
                    if home and profile.host == host
                      row gap=12 align-items="center" testId="profile"
                        image profile.avatar width=44 height=44 border-radius=22 object-fit="cover" alt=""
                        column flex=1 min-width=0 gap=2
                          text profile.name overflow-wrap="break-word" font-weight=600 testId="profile-name"
                          text profile.handle overflow-wrap="break-word" font="-exact-footnote" color="-exact-secondary-label" testId="profile-handle"
                    if instance.thumbnail != ""
                      image instance.thumbnail width="100%" aspect-ratio="1.91" object-fit="cover" border-radius=12 alt=""
                    text instance.title font="-exact-title2" font-weight=700 overflow-wrap="break-word" testId="instance-title"
                    link href=`https://${instance.domain}` testId="instance-url"
                      text `https://${instance.domain}` overflow-wrap="break-word"
                    text instance.description white-space="pre-line" color="-exact-secondary-label" overflow-wrap="break-word" testId="instance-description"
                    if home
                      button press=switchInstance buttonStyle="bordered" testId="switch-instance"
                        text "Switch Instance"
              column flex=1 min-width=0 display="flex" flex-direction="column"
                if timelineError != "" and posts.length == 0
                  column padding=16 gap=12 align-items="center"
                    text timelineError text-align="center" testId="timeline-error"
                    button press=retry buttonStyle="bordered" testId="retry"
                      text "Try Again"
                else if posts.length == 0 and pending(timeline)
                  column padding=16 align-items="center"
                    progress aria-label="Loading" testId="loading"
                else
                  list id="posts" testId="posts" virtualized=true appearance="none" flex=1 min-height=0
                    estimated-item-height=120 reachend=loadMore reach-margin="100%"
                    for p in rows key=p.id
                      PostRow(p=p, wide=wide, signedIn=timeline.signedIn, prefix="", open=openPost, boost=boost, favourite=favourite, openTag=openTag, focused=false)

              if centered and instance.domain == host
                column width="calc(50% - 300px)" flex-shrink=0
        if e.name == "post"
          PostView(route=`${e.id}`, host=e.params.host, id=e.params.id, wide=wide, back=back, show=showPost, openTag=openTag, changed=postChanged)

// A post and the posts around it: what it replies to above, its replies below.
component PostView
  props
    route: string
    host: string
    id: string
    wide: bool
    back: action
    show: action
    openTag: action
    changed: action
  resource thread = loadThread(host, id) as shape Thread else empty() transient
  mutation acted as shape Reply refreshes thread then afterAct
  derive ready = thread.host == host and thread.id == id
  derive error = match failure(thread) { case some(f) => (f.code == "not-found" ? "This post isn't available." : f.code == "auth-required" ? "This server only shows posts to signed-in users." : f.code == "auth-expired" ? "Log in again to see this post." : "Couldn't load the post."), case none => "" }

  action open(p: Post)
    if p.statusId != id
      show(host, p.statusId)
  action afterAct
    changed()
  action favourite(p: Post)
    if thread.signedIn and not pending(acted)
      send acted = act(host, p.statusId, p.favourited ? "unfavourite" : "favourite")
  action boost(p: Post)
    if thread.signedIn and not pending(acted)
      send acted = act(host, p.statusId, p.reblogged ? "unreblog" : "reblog")
  action retry
    refresh thread

  view
    column navigationKey=route navigationScroll="thread" position="absolute" inset=0 display="flex" flex-direction="column"
      header
        button id="back" press=back testId="post-back"
          text "Back"
        text "Post" role="heading" aria-level=2 testId="post-title"
      if error != "" and not ready
        column padding=16 gap=12 align-items="center"
          text error text-align="center" testId="thread-error"
          button press=retry buttonStyle="bordered" testId="thread-retry"
            text "Try Again"
      else if not ready
        column padding=16 align-items="center"
          progress aria-label="Loading" testId="thread-loading"
      else
        list id="thread" testId="thread" appearance="none" flex=1 min-height=0
          for p in thread.ancestors key=p.id
            PostRow(p=p, wide=wide, signedIn=thread.signedIn, prefix="thread-", open=open, boost=boost, favourite=favourite, openTag=openTag, focused=false)
          PostRow(p=thread.post, wide=wide, signedIn=thread.signedIn, prefix="focus-", focused=true, open=open, boost=boost, favourite=favourite, openTag=openTag)
          for p in thread.replies key=p.id
            PostRow(p=p, wide=wide, signedIn=thread.signedIn, prefix="thread-", open=open, boost=boost, favourite=favourite, openTag=openTag, focused=false)

// One post in a list. Tapping it opens the post; its buttons and hashtags do their own thing.
component PostRow
  // A hashtag's press also reaches the row's; the row skips the press that opened a hashtag.
  state tagged = false
  action down
    tagged = false
  action tag(e: AtomEvent)
    tagged = true
    openTag(e)
  action pressed
    if not tagged
      open(p)
    tagged = false
  props
    p: Post
    wide: bool
    signedIn: bool
    prefix: string
    focused: bool
    open: action
    boost: action
    favourite: action
    openTag: action
  view
    row gap=12 padding=(wide ? 16 : 12) align-items="flex-start" width="100%" box-sizing="border-box" max-width=(wide ? "600px" : "none") margin-left="auto" margin-right="auto"
      border-style="solid" border-color="-exact-separator" border-width=(wide ? "0 1px 1px" : "0 0 1px") testId=`${prefix}post-${p.id}`
      if p.id == "loading"
        progress aria-label="Loading" testId="loading"
      else
        image p.avatar width=44 height=44 border-radius=22 object-fit="cover" alt=""
        column flex=1 min-width=0
          // The press is on the content only, so the action buttons aren't nested in it.
          column press=pressed pointerdown=down gap=2 testId=`${prefix}open-${p.id}`
            if p.boostedBy != ""
              row gap=6 align-items="center" font="-exact-footnote" color="-exact-secondary-label" margin-bottom=2
                image "symbol:repeat" aria-hidden=true
                if p.boostedAvatar != ""
                  image p.boostedAvatar width=16 height=16 border-radius=8 object-fit="cover" alt=""
                text `${p.boostedBy} boosted` testId=`${prefix}boosted-${p.id}`
            row gap=6 align-items="center" flex-wrap="wrap"
              text p.name flex=1 min-width=0 overflow-wrap="break-word" font-weight=600 testId=`${prefix}name-${p.id}`
              image (p.visibility == "public" ? "symbol:icon.globe" : p.visibility == "unlisted" ? "symbol:moon" : p.visibility == "private" ? "symbol:lock" : "symbol:at")
                aria-label=(p.visibility == "public" ? "Public" : p.visibility == "unlisted" ? "Quiet public" : p.visibility == "private" ? "Followers only" : "Mentioned people only")
                font="-exact-footnote" width="1em" height="1em" flex-shrink=0 color="-exact-secondary-label" testId=`${prefix}visibility-${p.id}`
              if not focused
                text "·" font="-exact-footnote" color="-exact-secondary-label" aria-hidden=true
                time datetime=p.posted format="relative" max-width="100%" font="-exact-footnote" color="-exact-secondary-label" testId=`${prefix}time-${p.id}`
            text p.handle overflow-wrap="break-word" font="-exact-footnote" color="-exact-secondary-label"
            text p.text markup="markdown" atoms="hashtag" atompress=tag overflow-wrap="break-word" margin-top=4 font=(focused ? "-exact-title3" : "-exact-body") testId=`${prefix}text-${p.id}`
            if focused
              row gap=6 flex-wrap="wrap" margin-top=8 font="-exact-footnote" color="-exact-secondary-label" testId=`${prefix}posted-${p.id}`
                time datetime=p.posted format="date-medium"
                time datetime=p.posted format="time-short"
          row gap=16 margin-top=4 align-items="center" font="-exact-subheadline" color="-exact-secondary-label"
            button appearance="none" disabled=true aria-label=`Reply, ${p.replies}` display="flex" gap=4 align-items="center" min-width=44 min-height=44 testId=`${prefix}reply-${p.id}`
              image "symbol:reply" aria-hidden=true
              text (p.replies > 0 ? `${p.replies}` : "") testId=`${prefix}replies-${p.id}`
            button appearance="none" press=boost(p) disabled=(not signedIn) aria-label=(p.reblogged ? "Undo boost" : "Boost") aria-pressed=p.reblogged
              display="flex" gap=4 align-items="center" min-width=44 min-height=44 color=(p.reblogged ? "light-dark(#1a7f37, #30d158)" : "-exact-secondary-label") testId=`${prefix}boost-${p.id}`
              image "symbol:repeat" aria-hidden=true
              text (p.reblogs > 0 ? `${p.reblogs}` : "") testId=`${prefix}reblogs-${p.id}`
            button appearance="none" press=favourite(p) disabled=(not signedIn) aria-label=(p.favourited ? "Unlike" : "Like") aria-pressed=p.favourited
              display="flex" gap=4 align-items="center" min-width=44 min-height=44 color=(p.favourited ? "light-dark(#b45309, #ff9f0a)" : "-exact-secondary-label") testId=`${prefix}favourite-${p.id}`
              image (p.favourited ? "symbol:star-fill" : "symbol:star") aria-hidden=true
              text (p.favourites > 0 ? `${p.favourites}` : "") testId=`${prefix}favourites-${p.id}`
