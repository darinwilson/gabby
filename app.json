{
  "$schema": "../exact-repo/scripts/app.schema.json",
  "name": "Gabby",
  "short_name": "Gabby",
  "id": "com.example.gabby-be219f",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "com.example.gabby-be219f",
    "name": "Gabby"
  },
  "host": {
    "web": {},
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone",
        "ipad"
      ]
    },
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 900,
        "height": 700
      }
    }
  },
  "deploy": {
    "store": {
      "web": "0",
      "ios": "0",
      "macos": "0"
    }
  },
  "commands": {
    "server": [
      "bun",
      "fixture/server.ts"
    ],
    "test-local": [
      "bun",
      "exact.mjs",
      "test",
      "web",
      "--backend",
      "http://127.0.0.1:4790"
    ],
    "verify-local": [
      "bun",
      "exact.mjs",
      "verify",
      "web",
      "--backend",
      "http://127.0.0.1:4790"
    ],
    "sandbox": [
      "bun",
      "sandbox/sandbox.ts",
      "start"
    ],
    "sandbox-reset": [
      "bun",
      "sandbox/sandbox.ts",
      "reset"
    ],
    "web-sandbox": [
      "env",
      "EXACT_BACKEND_ORIGIN=http://127.0.0.1:4790",
      "bun",
      "exact.mjs",
      "web"
    ]
  },
  "server": {
    "database": false
  },
  "icons": [
    {
      "src": "assets/icon.png",
      "sizes": "1024x1024",
      "type": "image/png"
    }
  ],
  "verify": {
    "accept": [
      {
        "finding": "overlap",
        "node": "compose-fab",
        "why": "The compose button floats over the timeline by design; the list pads its end so the last post scrolls clear of it."
      },
      {
        "finding": "overlap",
        "node": "open-*",
        "why": "A post scrolling under the floating compose button; the list pads its end so the last post scrolls clear of it."
      }
    ]
  }
}
