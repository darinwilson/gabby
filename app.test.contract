test "signed in on a narrow window, the compose button posts to the home timeline"
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
  authorize
  clock data
  clock settle
  clock data
  tap "compose-fab"
  clock settle
  clock data
  expect text "compose-title" == "New Post"
  expect disabled "compose-post"
  type "compose-text" "Hello from Gabby"
  type "compose-visibility" "unlisted"
  expect text "compose-left" == "484"
  tap "compose-post"
  clock data
  clock data
  clock settle
  clock data
  expect tree missing "compose-title"
  expect text "text-new" == "Hello from Gabby"
  expect text "timeline-title" == "Home"

