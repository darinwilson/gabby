test "a photo is attached to a post, and can be removed"
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
  authorize
  clock data
  clock settle
  clock data
  tap "compose-fab"
  clock settle
  clock data
  tap "compose-attach"
  pick "compose-file" "assets/icon.png"
  clock data
  clock data
  expect tree has "compose-media-m1"
  tap "compose-remove-m1"
  clock data
  clock data
  expect tree missing "compose-media-m1"
  tap "compose-attach"
  pick "compose-file" "assets/icon.png"
  clock data
  clock data
  expect tree has "compose-media-m1"
  tap "compose-post"
  clock data
  clock data
  clock settle
  clock data
  expect tree missing "compose-title"
  expect tree has "post-new"

test "a very wide window keeps the timeline centered"
  size 1400x900
  at "/timeline/fosstodon.org"
  clock data
  expect tree has "centered-spacer"

test "a post that can't reach the server says so"
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
  authorize
  clock data
  clock settle
  clock data
  tap "compose-fab"
  clock settle
  clock data
  type "compose-text" "Hello"
  fail fetch "http://127.0.0.1:4790/mastodon.art/api/v1/statuses"
  tap "compose-post"
  clock data
  clock settle
  expect text "compose-error" == "Couldn't reach the server. Check your connection and try again."
  expect tree has "compose-title"

test "the counter counts as Mastodon does, and a post over the limit can't be sent"
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
  authorize
  clock data
  clock settle
  clock data
  tap "compose-fab"
  clock settle
  clock data
  type "compose-text" "See https://example.com/a/very/long/path/that/goes/on/and/on/for/quite/a/while/indeed"
  clock data
  expect text "compose-left" == "473"
  type "compose-text" "👍🏽"
  clock data
  expect text "compose-left" == "499"
  type "compose-text" ""
  clock data
  expect text "compose-left" == "-1"
  expect disabled "compose-post"

test "a video waits for the server to process it, and can't be mixed with images"
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
  authorize
  clock data
  clock settle
  clock data
  tap "compose-fab"
  clock settle
  clock data
  tap "compose-attach"
  pick "compose-file" "fixture/media/clip.mp4"
  clock data
  clock settle
  clock data
  clock settle
  clock data
  expect tree has "compose-media-m1"
  tap "compose-attach"
  pick "compose-file" "assets/icon.png"
  clock data
  clock data
  expect text "compose-upload-error" == "A post can have one video or audio file, or up to 4 images."
  expect tree missing "compose-media-m2"
  tap "compose-post"
  clock data
  clock data
  clock settle
  clock data
  expect tree missing "compose-title"
  expect tree has "post-new"

test "picking more files than a post can have adds what fits, and Cancel discards them"
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
  authorize
  clock data
  clock settle
  clock data
  tap "compose-fab"
  clock settle
  clock data
  tap "compose-attach"
  pick "compose-file" "assets/icon.png" "assets/icon.png" "assets/icon.png" "assets/icon.png" "assets/icon.png"
  clock data
  clock data
  expect tree has "compose-media-m4"
  expect text "compose-upload-error" == "A post can have at most 4 files."
  expect disabled "compose-attach"
  tap "compose-remove-m4"
  clock data
  clock data
  expect tree missing "compose-upload-error"
  tap "compose-back"
  clock data
  clock settle
  tap "compose-fab"
  clock settle
  clock data
  expect tree missing "compose-media-m1"

test "a reply from a post's view mentions everyone but you, and shows in the thread"
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
  authorize
  clock data
  clock settle
  clock data
  tap "open-h1"
  clock settle
  clock data
  tap "focus-reply-h1"
  clock settle
  clock data
  expect text "reply-title" == "Reply"
  expect text "reply-to" == "Replying to Ada"
  expect text "compose-left" == "488"
  expect text "compose-post" == "Reply"
  type "compose-text" "@ada@mastodon.art Thanks"
  tap "compose-post"
  clock data
  clock data
  clock settle
  clock data
  expect tree missing "reply-title"
  expect text "post-title" == "Post"
  expect text "thread-text-new" == "@ada@mastodon.art Thanks"
  expect text "focus-replies-h1" == "11"
  tap "post-back"
  clock settle
  clock data
  expect text "replies-h1" == "11"

test "a reply from the timeline keeps the post's visibility, and Cancel goes back"
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
  authorize
  clock data
  clock settle
  clock data
  tap "reply-l1"
  clock settle
  clock data
  expect text "reply-to" == "Replying to Lin"
  expect text "compose-visibility" == "private"
  tap "reply-back"
  clock settle
  expect tree missing "reply-title"
  expect text "timeline-title" == "Home"
  expect text "replies-l1" == "10"

