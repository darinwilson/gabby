test "an avatar opens its profile, pinned posts first, and Back returns"
  at "/timeline/fosstodon.org"
  clock data
  tap "avatar-2"
  clock settle
  clock data
  expect text "person-title" == "Ada"
  expect text "person-name" == "Ada"
  expect text "person-handle" == "@ada@fosstodon.org"
  expect text "person-statuses" == "2 posts"
  expect text "person-following" == "45 following"
  expect text "person-followers" == "120 followers"
  expect text "field-name-0" == "Website"
  expect tree has "person-bio"
  expect tree missing "person-banner"
  expect tree missing "person-follow"
  expect tree has "pinned-pinned-1"
  expect text "pinned-text-1" == "An older public post"
  expect tree has "person-post-2"
  tap "person-back"
  clock settle
  expect tree missing "person-title"
  expect text "timeline-title" == "Public"

test "a post in a profile opens it"
  at "/timeline/fosstodon.org"
