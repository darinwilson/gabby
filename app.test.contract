fail fetch "https://"

test "an address that isn't a URL is refused"
  type "server" "not a server"
  tap "connect"
  clock data
  expect text "server-hint" == "Enter a server address, like mastodon.social."

test "an unreachable server is refused"
  fail fetch "http://127.0.0.1:4790/nowhere.example"
  type "server" "nowhere.example"
  tap "connect"
  clock data
  expect text "server-hint" == "Couldn't reach nowhere.example."

test "a server Gabby can log in to offers login and its public timeline"
  type "server" "https://fosstodon.org/"
  tap "connect"
  clock data
  clock data
  expect tree has "log-in"
  expect text "options-hint" == ""
  tap "show-public"
  clock settle
  clock data
  expect tree has "posts"

test "another server says login isn't possible and offers its public timeline"
  type "server" "hachyderm.io"
  tap "connect"
  clock data
  clock data
  expect tree missing "log-in"
  expect text "options-hint" == "You can't log in to hachyderm.io from Gabby. Login works with fosstodon.org, mastodon.social and mastodon.art."
  tap "show-public"
  clock settle
  clock data
  expect tree has "posts"

test "editing the address hides the options"
  type "server" "hachyderm.io"
  tap "connect"
  clock data
  type "server" "hachyderm"
  expect tree missing "options"

test "logging in shows the home timeline"
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
  authorize
  clock data
  clock settle
  clock data
  expect text "text-h1" == "A post from someone you follow"
  expect text "timeline-title" == "Home"

test "a wide window shows the server beside its timeline"
  size 1280x900
  at "/timeline/fosstodon.org"
  clock data
  expect text "instance-title" == "Fosstodon"
  expect tree has "posts"

test "a narrow window shows no server sidebar"
  at "/timeline/fosstodon.org"
  clock data
  expect tree missing "instance"

test "a wide home timeline shows who's logged in, and Recent returns to it without logging in"
  size 1280x900
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
  authorize
  clock data
  clock settle
  clock data
  expect text "profile-name" == "Darin"
  expect text "profile-handle" == "@darin@mastodon.art"
  tap "switch-instance"
  clock settle
  clock data
  tap "recent-mastodon.art"
  clock settle
  clock data
  expect text "text-h1" == "A post from someone you follow"

test "timelines are titled Home or Public"
  at "/timeline/fosstodon.org"
  clock data
  expect text "timeline-title" == "Public"

test "a hashtag shows its posts under its name, and Back returns"
  at "/tag/fosstodon.org/birds"
  clock data
  expect text "timeline-title" == "#birds"
  expect text "text-t1" == "A post about birds"
  tap "back"
  clock settle
  expect tree missing "back"

test "a boosted post names who boosted it"
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
  authorize
  clock data
  clock settle
  clock data
  expect text "boosted-h2" == "Grace boosted"
  expect text "text-h2" == "A post someone you follow boosted"
  expect tree missing "boosted-h1"

test "liking and boosting a post count it"
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
  authorize
  clock data
  clock settle
  clock data
  expect text "replies-h1" == "10"
  expect text "reblogs-h1" == "6"
  expect text "favourites-h1" == "1"
  tap "favourite-h1"
  clock data
  clock data
  expect text "favourites-h1" == "2"
  tap "boost-h1"
  clock data
  clock data
  expect text "reblogs-h1" == "7"

test "signed out, a post can't be liked"
  at "/timeline/fosstodon.org"
  clock data
  expect disabled "favourite-1"
  expect disabled "boost-1"

test "a post opens with its replies, and Back returns to the timeline"
  at "/timeline/fosstodon.org"
  clock data
  tap "name-2"
  clock settle
  clock data
  expect text "post-title" == "Post"
  expect text "focus-name-2" == "Ada"
  expect text "thread-text-c1" == "A reply"
  expect text "thread-text-c2" == "A reply to the reply"
  tap "post-back"
  clock settle
  expect tree missing "post-title"
  expect text "timeline-title" == "Public"
  expect text "text-1" == "An older public post"

test "a reply shows what it replies to, and opens another post over it"
  at "/post/fosstodon.org/c2"
  clock data
  expect text "focus-text-c2" == "A reply to the reply"
  expect text "thread-text-c1" == "A reply"
  tap "thread-open-c1"
  clock settle
  clock data
  expect text "focus-text-c1" == "A reply"

test "a post that's gone says so"
  at "/post/fosstodon.org/gone"
  clock data
  expect text "thread-error" == "This post isn't available."

test "liking a post from its view counts it there and in the timeline"
  type "server" "mastodon.art"
  tap "connect"
  clock data
  clock data
  tap "log-in"
