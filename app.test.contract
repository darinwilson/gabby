  tap "avatar-2"
  clock settle
  clock data
  tap "person-open-2"
  clock settle
  clock data
  expect text "post-title" == "Post"
  expect text "thread-text-c1" == "A reply"

test "an avatar in a post's view opens its profile"
  at "/timeline/fosstodon.org"
  clock data
  tap "name-2"
  clock settle
  clock data
  tap "thread-avatar-c1"
  clock settle
